{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "0.1.0",
  "identifier": "com.dashboardmanager.memo",
  "build": {
    "frontendDist": "../../memo/src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Memo",
        "width": 400,
        "height": 510,
        "minWidth": 220,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "unlock",
        "title": "Unlock Memo",
        "url": "unlock.html",
        "width": 44,
        "height": 44,
        "minWidth": 44,
        "minHeight": 44,
        "maxWidth": 44,
        "maxHeight": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
