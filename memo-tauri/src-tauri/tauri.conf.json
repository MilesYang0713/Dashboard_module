{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "0.1.0",
  "identifier": "com.dashboardmanager.memo",
  "build": {
    "frontendDist": "../../memo/src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Memo",
        "width": 400,
        "height": 510,
        "minWidth": 220,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "backgroundColor": "#00000000",
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "unlock-overlay",
        "title": "Memo unlock control",
        "url": "unlock.html",
        "width": 52,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
