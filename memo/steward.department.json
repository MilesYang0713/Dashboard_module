{
  "protocol": "steward.department/v1",
  "id": "memo",
  "name": "Memo 备忘与事件部",
  "version": "1.0.0",
  "description": "将自然语言或剪贴板内容保存为本地可排序事件。",
  "transport": {
    "type": "windows-named-pipe",
    "endpoint": "\\\\.\\pipe\\steward-memo-v1"
  },
  "appPath": "memo",
  "privacy": {
    "network": "none",
    "dataScope": "memo events only"
  },
  "actions": [
    {
      "id": "capture",
      "title": "记录备忘",
      "mode": "write",
      "approval": "none",
      "input": { "text": "string" },
      "output": { "summary": "string", "event": "object" }
    },
    {
      "id": "list",
      "title": "查看事件概览",
      "mode": "read",
      "approval": "none",
      "input": {},
      "output": { "events": "array" }
    }
  ]
}
